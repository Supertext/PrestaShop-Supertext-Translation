{#
 # Translate with Supertext: the selected items, a column per shop language, and the
 # languages to translate into. Translating calls runUrl once per item and language.
 #}
{% extends '@PrestaShop/Admin/layout.html.twig' %}
{% block content %}
{% set d = 'Modules.Supertext.Admin' %}
<style>
  .supertext-page .st-state { font-size: .85rem; }
  .supertext-page .st-table td:first-child { min-width: 14rem; }
  .supertext-page .st-state.none { color: #6c868e; }
  .supertext-page .st-state.partial { color: #a35c00; }
  .supertext-page .st-state.translated, .supertext-page .st-state.done { color: #1f8a49; font-weight: 600; }
  .supertext-page .st-state.error { color: #c0392b; font-weight: 600; white-space: normal; }
  .supertext-page .st-state.running { color: #25b9d7; }
  .supertext-page .st-langs label { margin-right: 1.5rem; font-weight: normal; }
  .supertext-page .st-overwrite-warning { display: none; margin-top: .75rem; margin-bottom: 0; }
  .supertext-page .st-overwrite:checked ~ .st-overwrite-warning { display: block; }
  .supertext-page .st-summary { display: none; }
  .supertext-page th.st-lang, .supertext-page td.st-lang-cell { min-width: 9rem; }
  .supertext-page .st-files { margin-top: 1.5rem; }
  .supertext-page .st-files label { font-weight: normal; margin-right: 1.5rem; }
  .supertext-page .st-import-result { display: none; margin-top: 1rem; }
  .supertext-page .st-import-result ul { margin: .25rem 0 .75rem 1.25rem; padding: 0; }
</style>

<div class="supertext-page" data-run-url="{{ runUrl }}" data-type="{{ type }}" data-source="{{ source.id }}">
  {% if not hasApiKey %}
    <div class="alert alert-warning">
      <p><strong>{{ 'Supertext is not set up yet.'|trans({}, d) }}</strong>
        {{ 'An administrator needs to enter the API key in the %link%module settings%end%.'|trans({'%link%': '<a href="' ~ settingsUrl ~ '">', '%end%': '</a>'}, d)|raw }}</p>
      <p>{{ 'No Supertext account yet?'|trans({}, d) }}
        <a href="{{ signupUrl }}" target="_blank" rel="noopener">{{ 'Create one at supertext.com.'|trans({}, d) }}</a>
        {{ 'Generate your API key at'|trans({}, d) }}
        <a href="{{ apiKeyUrl }}" target="_blank" rel="noopener">supertext.com → Integrations → API</a>
        {{ '(requires the Admin role).'|trans({}, d) }}</p>
    </div>
  {% endif %}

  {% if not canEdit %}
    <div class="alert alert-danger">{{ 'You are not allowed to edit this item.'|trans({}, d) }}</div>
  {% endif %}

  <div class="card">
    <h3 class="card-header"><i class="material-icons">translate</i> {{ typeLabel }}: {{ items|length }}</h3>
    <div class="card-body">
      {% if items is empty %}
        <p>{{ 'Nothing selected. Go back to the list and tick the items to translate.'|trans({}, d) }}</p>
      {% else %}
        <form class="st-form" onsubmit="return false">
          <div class="form-group row">
            <label class="col-sm-3 col-form-label" for="st-source">{{ 'Translate from'|trans({}, d) }}</label>
            <div class="col-sm-4">
              <select id="st-source" class="custom-select" onchange="location.href='{{ selfUrl|e('js') }}&source=' + this.value">
                {% for language in languages %}
                  <option value="{{ language.id }}"{% if language.id == source.id %} selected{% endif %}>{{ language.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>

          <div class="form-group row">
            <div class="col-sm-3 col-form-label">{{ 'Translate into'|trans({}, d) }}</div>
            <div class="col-sm-9 st-langs pt-2">
              {% for language in targets %}
                <label for="st-lang-{{ language.id }}">
                  <input type="checkbox" class="st-target" id="st-lang-{{ language.id }}" value="{{ language.id }}"{% if language.code %} checked{% else %} disabled{% endif %}>
                  {{ language.name }} {% if language.code %}<code>{{ language.code }}</code>{% else %}<span class="badge badge-danger st-not-mapped">{{ 'No Supertext language yet: an administrator needs to choose one in the module settings.'|trans({}, d) }}</span>{% endif %}{% if not language.active %} <span class="badge badge-secondary">{{ 'Inactive'|trans({}, d) }}</span>{% endif %}
                </label>
              {% endfor %}
            </div>
          </div>

          <div class="form-group row">
            <div class="col-sm-3"></div>
            <div class="col-sm-9">
              <input type="checkbox" class="st-overwrite" id="st-overwrite">
              <label for="st-overwrite" class="mb-0">{{ 'Overwrite existing translations'|trans({}, d) }}</label>
              <div class="alert alert-warning st-overwrite-warning" role="alert">
                {{ 'Fields that are already translated will be replaced by the new Supertext translation. Changes made by hand in those languages are lost.'|trans({}, d) }}
              </div>
              <p class="small text-muted mt-2 mb-0">{{ 'Without this option, only fields that are empty or still identical to the source language are filled.'|trans({}, d) }}</p>
            </div>
          </div>

          <table class="table st-table">
            <thead>
              <tr>
                <th>{{ 'Name'|trans({}, d) }} ({{ source.name }})</th>
                {% for language in targets %}
                  <th class="st-lang" data-lang="{{ language.id }}">{{ language.name }}</th>
                {% endfor %}
              </tr>
            </thead>
            <tbody>
              {% for item in items %}
                <tr data-id="{{ item.id }}">
                  <td><a href="{{ item.editUrl }}">{{ item.title }}</a> <span class="text-muted">#{{ item.id }}</span></td>
                  {% for language in targets %}
                    {% set state = item.states[language.id] %}
                    <td class="st-lang-cell" data-lang="{{ language.id }}">
                      <span class="st-state {{ state }}">
                        {%- if state == 'translated' -%}✓ {{ 'Translated'|trans({}, d) }}
                        {%- elseif state == 'partial' -%}◐ {{ 'Partly translated'|trans({}, d) }}
                        {%- else -%}– {{ 'Not translated'|trans({}, d) }}{%- endif -%}
                      </span>
                    </td>
                  {% endfor %}
                </tr>
              {% endfor %}
            </tbody>
          </table>

          <div class="alert alert-success st-summary" role="status"></div>
        </form>
      {% endif %}
    </div>
    <div class="card-footer d-flex justify-content-between">
      <a class="btn btn-outline-secondary" href="{{ listUrl }}">{{ 'Back to the list'|trans({}, d) }}</a>
      {% if items is not empty %}
        <button type="button" class="btn btn-primary st-go"{% if not hasApiKey or not canEdit %} disabled{% endif %}>
          <i class="material-icons">translate</i> {{ 'Translate'|trans({}, d) }}
        </button>
      {% endif %}
    </div>
  </div>
  {% if canEdit %}
  <div class="row st-files">
    {% if items is not empty %}
    <div class="col-lg-6">
      <form class="card st-export" method="post" action="{{ exportUrl }}">
        <h3 class="card-header"><i class="material-icons">file_download</i> {{ 'Export for translation'|trans({}, d) }}</h3>
        <div class="card-body">
          <p class="small text-muted">{{ 'Translate the file in a translation tool, by a translator or in Supertext\'s web app, then import it here.'|trans({}, d) }}</p>
          <input type="hidden" name="type" value="{{ type }}">
          <input type="hidden" name="source" value="{{ source.id }}">
          <div class="form-group">
            <label class="d-block" for="st-export-item"><strong>{{ 'Name'|trans({}, d) }} ({{ source.name }})</strong></label>
            <select id="st-export-item" name="id" class="custom-select">
              {% for item in items %}<option value="{{ item.id }}">{{ item.title }} (#{{ item.id }})</option>{% endfor %}
            </select>
          </div>
          <div class="form-group">
            <strong class="d-block">{{ 'File format'|trans({}, d) }}</strong>
            <label><input type="radio" name="format" value="xliff" checked> {{ 'XLIFF 1.2 (for translation tools)'|trans({}, d) }}</label>
            <label><input type="radio" name="format" value="html"> {{ 'HTML (one language per file)'|trans({}, d) }}</label>
          </div>
          <div class="form-group mb-0">
            <strong class="d-block">{{ 'Translate into'|trans({}, d) }}</strong>
            {% for language in targets %}
              <label><input type="checkbox" class="st-export-target" name="targets[]" value="{{ language.id }}"{% if loop.first %} checked{% endif %}> {{ language.name }}</label>
            {% endfor %}
          </div>
        </div>
        <div class="card-footer text-right">
          <button type="submit" class="btn btn-outline-primary st-export-go"><i class="material-icons">file_download</i> {{ 'Download file'|trans({}, d) }}</button>
        </div>
      </form>
    </div>
    {% endif %}
    <div class="col-lg-6">
      <form class="card st-import" method="post" action="{{ importUrl }}" enctype="multipart/form-data" onsubmit="return false">
        <h3 class="card-header"><i class="material-icons">file_upload</i> {{ 'Import translation'|trans({}, d) }}</h3>
        <div class="card-body">
          <div class="form-group">
            <label class="d-block" for="st-import-file"><strong>{{ 'Translated file (XLIFF or HTML)'|trans({}, d) }}</strong></label>
            <input type="file" id="st-import-file" name="file" class="form-control-file" accept=".xlf,.xliff,.html,.htm,application/x-xliff+xml,text/html">
          </div>
          <div><label><input type="checkbox" name="include_changed" value="1"> {{ 'Also import texts whose source changed since the export'|trans({}, d) }}</label></div>
          <div><label><input type="checkbox" name="overwrite" value="1"> {{ 'Overwrite existing translations'|trans({}, d) }}</label></div>
          <div class="st-import-result alert" role="status"></div>
        </div>
        <div class="card-footer text-right">
          <button type="button" class="btn btn-outline-primary st-import-go"><i class="material-icons">file_upload</i> {{ 'Import translation'|trans({}, d) }}</button>
        </div>
      </form>
    </div>
  </div>
  {% endif %}
</div>

<script>
(function () {
  var root = document.querySelector('.supertext-page');
  var form = root && root.querySelector('.st-import');
  if (form) {
    var tooLarge = {{ 'The file is too large (at most 10 MB).'|trans({}, d)|json_encode|raw }};
    var failed = {{ 'Failed'|trans({}, d)|json_encode|raw }};
    var box = form.querySelector('.st-import-result');
    var show = function (cls, nodes) {
      box.className = 'st-import-result alert ' + cls; box.style.display = 'block';
      box.textContent = ''; nodes.forEach(function (n) { box.appendChild(n); });
    };
    var text = function (tag, value) { var el = document.createElement(tag); el.textContent = value; return el; };
    form.querySelector('.st-import-go').addEventListener('click', async function () {
      var input = form.querySelector('input[type=file]');
      if (!input.files.length) { input.focus(); return; }
      if (input.files[0].size > {{ maxUpload }}) { show('alert-danger', [text('div', tooLarge)]); return; }
      var button = this; button.disabled = true;
      try {
        var response = await fetch(form.getAttribute('action'), { method: 'POST', body: new FormData(form), credentials: 'same-origin', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        var data = await response.json();
        if (!data.ok) { show('alert-danger', [text('div', data.message || failed)]); return; }
        var nodes = [], bad = false;
        data.jobs.forEach(function (job) {
          nodes.push(text('strong', job.title + ' → ' + job.language));
          var list = document.createElement('ul');
          if (job.error) { bad = true; list.appendChild(text('li', job.error)); }
          job.lines.forEach(function (line) { list.appendChild(text('li', line)); });
          nodes.push(list);
        });
        show(bad ? 'alert-warning' : 'alert-success', nodes);
      } catch (e) {
        show('alert-danger', [text('div', failed + ' (' + e.message + ')')]);
      } finally {
        button.disabled = false;
      }
    });
  }
})();
(function () {
  var root = document.querySelector('.supertext-page');
  var go = root && root.querySelector('.st-go');
  if (!go) return;
  var t = {
    running: {{ 'Translating…'|trans({}, d)|json_encode|raw }},
    queued: {{ 'Waiting…'|trans({}, d)|json_encode|raw }},
    failed: {{ 'Failed'|trans({}, d)|json_encode|raw }},
    noLang: {{ 'Choose at least one language to translate into.'|trans({}, d)|json_encode|raw }},
    done: {{ 'Done: %ok% translated, %skipped% unchanged, %failed% failed.'|trans({}, d)|json_encode|raw }},
    skippedHint: {{ 'To replace existing translations, tick "Overwrite existing translations" and translate again.'|trans({}, d)|json_encode|raw }}
  };

  go.addEventListener('click', async function () {
    var langs = Array.prototype.map.call(root.querySelectorAll('.st-target:checked'), function (c) { return c.value; });
    if (!langs.length) { alert(t.noLang); return; }
    var overwrite = root.querySelector('.st-overwrite').checked;
    var rows = Array.prototype.slice.call(root.querySelectorAll('.st-table tbody tr'));
    var jobs = [];
    rows.forEach(function (row) {
      langs.forEach(function (lang) {
        var cell = row.querySelector('td[data-lang="' + lang + '"] .st-state');
        cell.className = 'st-state queued'; cell.textContent = t.queued;
        jobs.push({ id: row.getAttribute('data-id'), lang: lang, cell: cell });
      });
    });
    go.disabled = true;
    var counts = { ok: 0, skipped: 0, failed: 0 };
    for (var i = 0; i < jobs.length; i++) {
      var job = jobs[i];
      job.cell.className = 'st-state running'; job.cell.textContent = t.running;
      var body = new FormData();
      body.append('type', root.getAttribute('data-type'));
      body.append('id', job.id);
      body.append('source', root.getAttribute('data-source'));
      body.append('target', job.lang);
      body.append('overwrite', overwrite ? '1' : '0');
      try {
        var response = await fetch(root.getAttribute('data-run-url'), { method: 'POST', body: body, credentials: 'same-origin', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        var data = await response.json();
        if (data.ok) {
          job.cell.className = 'st-state ' + (data.status === 'unchanged' ? 'translated' : 'done');
          job.cell.textContent = '✓ ' + data.message;
          counts[data.status === 'unchanged' ? 'skipped' : 'ok']++;
        } else {
          job.cell.className = 'st-state error'; job.cell.textContent = '✕ ' + (data.message || t.failed);
          counts.failed++;
        }
      } catch (e) {
        job.cell.className = 'st-state error'; job.cell.textContent = '✕ ' + t.failed + ' (' + e.message + ')';
        counts.failed++;
      }
    }
    var summary = root.querySelector('.st-summary');
    summary.textContent = t.done.replace('%ok%', counts.ok).replace('%skipped%', counts.skipped).replace('%failed%', counts.failed)
      + (counts.skipped && !overwrite ? ' ' + t.skippedHint : '');
    summary.className = 'alert st-summary ' + (counts.failed ? 'alert-warning' : 'alert-success');
    summary.style.display = 'block';
    go.disabled = false;
  });
})();
</script>
{% endblock %}
