{
    "name": "supertext/prestashop-supertext-translation-dev",
    "description": "Development tooling for the Supertext PrestaShop module (the module itself is in supertext/)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Supertext\\PrestaShop\\": "supertext/src/",
            "Supertext\\PrestaShop\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse",
        "build": "./build.sh"
    },
    "config": {
        "sort-packages": true
    }
}
